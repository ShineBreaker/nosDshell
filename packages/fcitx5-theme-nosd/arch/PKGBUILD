pkgname=fcitx5-theme-deepin
pkgver=1.1
pkgrel=1
pkgdesc="Deepin looklike fcitx5 theme"
arch=('any')
url="https://github.com/linuxdeepin/fcitx5-theme-deepin"
license=('CC-BY-SA-4.0')
depends=('fcitx5')
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/share/fcitx5/themes/"
    cp -r "$startdir/../deepin-light" "$pkgdir/usr/share/fcitx5/themes/"
    cp -r "$startdir/../deepin-dark" "$pkgdir/usr/share/fcitx5/themes/"
}
