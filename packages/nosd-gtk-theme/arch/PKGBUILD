# Maintainer: nosDshell Theme Maintainers
pkgname=nosd-gtk-theme-git
pkgver=0.2.0
pkgrel=1
pkgdesc='nosDshell GTK themes (deepin light/dark)'
arch=('any')
url="https://github.com/nosDshell/nosd"
license=('GPL-3.0-or-later')
optdepends=('gtk-engine-murrine: for the GTK2 theme')
makedepends=('git')
provides=('nosd-gtk-theme' 'nosd-app-themes' 'deepin-gtk-theme')
conflicts=('nosd-gtk-theme' 'nosd-app-themes' 'deepin-gtk-theme')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

package() {
  make -C "$(_srcroot)/packages/nosd-gtk-theme" DESTDIR="$pkgdir" install
}
