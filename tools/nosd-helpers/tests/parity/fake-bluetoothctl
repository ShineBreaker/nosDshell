#!/bin/sh
# Fixture bluetoothctl: scripted success transcript for parity tests.
while IFS= read -r line; do
  cmd=$(printf '%s' "$line" | tr -d '\r')
  case "$cmd" in
    "agent on") echo "Agent registered" ;;
    "default-agent") echo "Default agent request successful" ;;
    "pair "*)
      echo "Attempting to pair with ${cmd#pair }"
      echo "Confirm passkey 123456 (yes/no)"
      IFS= read -r answer
      answer=$(printf '%s' "$answer" | tr -d '\r')
      if [ "$answer" = "yes" ]; then
        echo "Pairing successful"
        echo "Bonded: yes"
      else
        echo "Failed to pair: rejected"
      fi
      ;;
    "info "*) echo "Device AA:BB:CC:DD:EE:FF"; echo "Paired: yes"; echo "Connected: yes" ;;
    "trust "*) echo "trust succeeded" ;;
    "connect "*) echo "Connection successful" ;;
    "quit") echo "Bye"; exit 0 ;;
    "yes") : ;;
    *) echo "ok: $cmd" ;;
  esac
done
exit 0
